# Local development defaults. Replace placeholders before running the application.
MONGODB_URI=mongodb://127.0.0.1:27017/labreserve
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
HOST=0.0.0.0

# Used only by the admin seed script; do not reuse real account credentials.
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
