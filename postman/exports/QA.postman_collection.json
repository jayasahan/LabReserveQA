  "item": [
    {
      "name": "API Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [],
          "path": [
            "{{baseUrl}}",
            "api",
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Health check status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Health check reports the API is running\", function () {",
              "  pm.expect(response.status).to.eql(\"ok\");",
              "  pm.expect(response.app).to.eql(\"LabReserve API\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API 01 Admin Login",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [],
          "path": [
            "{{baseUrl}}",
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"admin@labreserve.local\",\r\n  \"password\": \"choose_a_private_password\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Admin login status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User has ADMIN role\", function () {",
              "    pm.expect(response.user.role).to.eql(\"ADMIN\");",
              "});",
              "",
              "if (response.token && response.user.role === \"ADMIN\") {",
              "    pm.environment.set(\"adminToken\", response.token);",
              "}"
            ]
          }
        }
      ]
    },
