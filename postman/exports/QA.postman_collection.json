          "raw": "{\r\n  \"name\": \"QA Test Equipment\",\r\n  \"category\": \"Testing\",\r\n  \"assetCode\": \"QA-TEST-001\",\r\n  \"description\": \"Equipment created for API testing\"\r\n}",
