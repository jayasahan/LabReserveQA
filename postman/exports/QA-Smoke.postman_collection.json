{
  "info": {
    "name": "QA Smoke",
    "_postman_id": "labreserve-qa-smoke",
    "description": "Minimal safe LabReserve API smoke tests. Login credentials must be supplied at runtime.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Health check status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Health check reports the API is running\", function () {",
              "  pm.expect(response.status).to.eql(\"ok\");",
              "  pm.expect(response.app).to.eql(\"LabReserve API\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Admin login status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User has ADMIN role\", function () {",
              "  pm.expect(response.user.role).to.eql(\"ADMIN\");",
              "});",
              "",
              "pm.test(\"Admin login returns a token\", function () {",
              "  pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "if (response.token && response.user && response.user.role === \"ADMIN\") {",
              "  pm.environment.set(\"adminToken\", response.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Student Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Student login status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User has STUDENT role\", function () {",
              "  pm.expect(response.user.role).to.eql(\"STUDENT\");",
              "});",
              "",
              "pm.test(\"Student login returns a token\", function () {",
              "  pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "if (response.token && response.user && response.user.role === \"STUDENT\") {",
              "  pm.environment.set(\"studentToken\", response.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin List Equipment",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/equipment",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "equipment"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Admin equipment listing status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Admin equipment listing returns an array\", function () {",
              "  pm.expect(response.equipment).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Student List Equipment",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/equipment",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "equipment"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Student equipment listing status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Student equipment listing returns an array\", function () {",
              "  pm.expect(response.equipment).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentPassword",
